# Production environment for https://qac.poolreno.com — API + PostgreSQL via docker compose.
#
#   cp api.env.example api.env          # then fill in every CHANGE_ME below
#   docker compose --env-file api.env up -d --build
#
# api.env is git-ignored and never copied into the image; it is read by docker compose
# (for ${…} substitution and the postgres container) and handed to the API as its environment.
# Reference for every variable: apps/api/.env.example and docs/DEPLOYMENT.md.

# --- Application --------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Public https origin of the site. E-mailed links and CSRF origin use it.
APP_URL=https://qac.poolreno.com
# Same-origin deployment (nginx proxies / and /api to one process) — no extra origins needed.
# ALLOWED_ORIGINS=https://qac.poolreno.com

# --- Database: PostgreSQL 16 (the "db" service in docker-compose.yml) --------
DB_CLIENT=postgres
DB_HOST=db
DB_PORT=5432
DB_USER=scope
# Strong, unique password. Used by the API and to initialise the postgres container (POSTGRES_PASSWORD).
DB_PASSWORD=CHANGE_ME
DB_DATABASE=scope_checklist
# Traffic stays on the private compose network; set "true" (or "no-verify") when pointing at a managed host instead.
DB_SSL=false
# Managed PostgreSQL instead of the bundled container: set DATABASE_URL, DB_SSL=true and remove the db service.
# DATABASE_URL=postgres://scope:password@host:5432/scope_checklist

# --- Sessions / security ------------------------------------------------------
# TLS terminates at nginx; the cookie is Secure and the API sends HSTS.
SESSION_SECURE=true
SESSION_COOKIE=scope_session
SESSION_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=60
# One reverse proxy (nginx) in front of the container.
TRUST_PROXY=1

# --- Sign-in ------------------------------------------------------------------
# Built-in e-mail + password. This host has no Clerk setup.
AUTH_PROVIDER=session
# Preloaded administrator. `npm run db:seed:admin` (or seed-admin.js) with no
# flags creates or updates this account. Change the password after first login.
SEED_ADMIN_EMAIL=admin@qac.poolreno.com
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=Admin1234!

# --- Exports / reporting ------------------------------------------------------
EXPORT_TIMEZONE=Asia/Manila
# PRODUCTIVITY_WEIGHTS=tasksCompleted=8,comments=2

# --- Logging ------------------------------------------------------------------
LOG_REQUESTS=true
