# Copy to .env (or export in your shell). Every value has a development default.
# Production checklist: docs/DEPLOYMENT.md

NODE_ENV=development
PORT=4000

# Public URL of the web app — used in password-reset/invitation links and as the default CORS/CSRF origin.
# Must be https:// in production.
APP_URL=http://localhost:5173
# Comma-separated list when several origins must be allowed.
# ALLOWED_ORIGINS=http://localhost:5173,https://scope.example.gov.ph

# Database: "sqlite" (zero-install, file-based), "mysql" (MySQL 8 / MariaDB 10.6+) or "postgres" (PostgreSQL 14+).
# Production refuses sqlite unless ALLOW_SQLITE_IN_PRODUCTION=true (single-user pilots only).
DB_CLIENT=sqlite
DB_FILE=storage/scope.sqlite
# MySQL / PostgreSQL connection (DB_PORT defaults to 3306 for mysql and 5432 for postgres; DB_USER to root / postgres).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_DATABASE=scope_checklist
# PostgreSQL only: a connection string wins over the fields above (what managed hosts hand out).
# DATABASE_URL=postgres://user:password@host:5432/scope_checklist
# PostgreSQL TLS: false (default), true (verify the server certificate) or no-verify (encrypt only; self-signed managed hosts).
# DB_SSL=false
# ALLOW_SQLITE_IN_PRODUCTION=false

# Account seeders (`npm run db:seed:admin` / `db:seed:user`). Flags win over these; set the
# password here or in the shell environment rather than on the command line. Not needed under Clerk.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=
# SEED_USER_NAME=
# SEED_USER_PASSWORD=

# Who signs users in: "session" (built-in e-mail + password, default) or "clerk".
# Leave unset to pick "clerk" automatically when CLERK_SECRET_KEY is present.
# Clerk keys are written here by `npx -y clerk@latest env pull` (run in apps/api); never commit them.
# AUTH_PROVIDER=session
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# Allowed server-clock drift when checking Clerk token timestamps (ms; default 60000). Keep the host on NTP.
# CLERK_CLOCK_SKEW_MS=60000
# Optional: the instance's "JWT public key" (Dashboard → API keys). Tokens are then verified
# locally without fetching the JWKS. Quote it to keep the line breaks:
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"

SESSION_COOKIE=scope_session
SESSION_TTL_DAYS=14
# Set true behind HTTPS (required in production; also enables Strict-Transport-Security).
SESSION_SECURE=false

PASSWORD_RESET_TTL_MINUTES=60

# IANA time zone printed on "checked at" timestamps in exported documents when the browser sends none.
EXPORT_TIMEZONE=Asia/Manila

# Points per activity bucket for Admin → Productivity. List only the buckets you want to change; the rest keep
# their defaults (tasksCompleted=5, tasksChecked=3, tasksCreated=2, tasksUpdated=1, comments=1, exports=1, other=1).
# Whole numbers >= 0; an unknown bucket or a bad value stops start-up. The UI legend always shows the active weights.
# PRODUCTIVITY_WEIGHTS=tasksCompleted=8,comments=2

# --- Deployment ---------------------------------------------------------------
# Serve the built web app (apps/web/dist) from this process so one port answers both the SPA and /api.
# Leave unset when nginx/a CDN hosts the frontend. Relative paths resolve from apps/api.
# WEB_DIST=../web/dist
# One access-log line per request (method, path, status, duration). Default: true, false under NODE_ENV=test.
LOG_REQUESTS=true
# Number of reverse proxies in front of the API (Express "trust proxy"); affects client IPs for rate limiting and secure-cookie detection.
TRUST_PROXY=1
# Local docker-compose trial only: skips the https/secure-cookie checks that production normally enforces.
# ALLOW_INSECURE_PRODUCTION=false
