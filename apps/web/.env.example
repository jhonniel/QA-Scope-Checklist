# Base URL of the REST API. Relative (`/api`) when served behind the same host,
# absolute (`https://api.example.gov.ph/api`) when hosted separately.
# Leave empty to use the in-memory mock data.
VITE_API_URL=/api

# Clerk sign-in. Set to the application's publishable key (written to .env.local by
# `npx -y clerk@latest env pull` in apps/web) and make sure the API runs with AUTH_PROVIDER=clerk.
# Leave unset for the built-in e-mail + password pages.
# VITE_CLERK_PUBLISHABLE_KEY=
